# ── Contact form email (Resend) ──
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=contact@xclator.com

# Verified sender for outbound mail. Must be a domain/address verified in Resend.
# Falls back to Resend's onboarding sender if unset.
CONTACT_FROM_EMAIL=Xclator Website <onboarding@resend.dev>
